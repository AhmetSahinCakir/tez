{
  "seed": 2,
  "stream_seed_offset": 0,
  "threads": 1,
  "log_every": 0,
  "save_model": false,
  "model": {
    "name": "mlp",
    "hidden_sizes": [
      100,
      100,
      100
    ],
    "activation": "relu",
    "layer_norm": false,
    "ln_affine": true,
    "reparam": {
      "hidden": "tanh",
      "output": "tanh"
    },
    "gamma": 1.5,
    "compact_bias": true,
    "init": "kaiming_uniform",
    "bias_init": "zeros",
    "learn_amplitude": false,
    "theta_scale": "amplitude"
  },
  "method": {
    "name": "baseline"
  },
  "optimizer": {
    "name": "sgd",
    "lr": 0.03,
    "weight_decay": 0.0
  },
  "train": {
    "batch_size": 32,
    "epochs_per_task": 1,
    "epochs": 10
  },
  "metrics": {
    "every_n_tasks": 1,
    "probe_size": 1000,
    "weights": true,
    "representation": true,
    "fisher": true,
    "fisher_samples": 32,
    "update_tracking_every": 100
  },
  "fresh_reference": {
    "every_n_tasks": 0
  },
  "summary": {
    "window": 0.1
  },
  "stream": {
    "name": "stationary",
    "dataset": "mnist",
    "normalize": "unit"
  }
}