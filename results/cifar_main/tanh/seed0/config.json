{
  "seed": 0,
  "stream_seed_offset": 0,
  "threads": 1,
  "log_every": 0,
  "save_model": false,
  "model": {
    "name": "mlp",
    "hidden_sizes": [
      64,
      64
    ],
    "activation": "relu",
    "layer_norm": false,
    "ln_affine": true,
    "reparam": {
      "hidden": "tanh",
      "output": "tanh"
    },
    "gamma": 5.0,
    "compact_bias": true,
    "init": "kaiming_uniform",
    "bias_init": "zeros",
    "learn_amplitude": false,
    "theta_scale": "amplitude"
  },
  "method": {
    "name": "baseline"
  },
  "optimizer": {
    "name": "sgd",
    "lr": 0.003,
    "weight_decay": 0.0
  },
  "train": {
    "batch_size": 1,
    "epochs_per_task": 1
  },
  "metrics": {
    "every_n_tasks": 10,
    "probe_size": 200,
    "weights": true,
    "representation": true,
    "fisher": true,
    "fisher_samples": 32,
    "update_tracking_every": 100
  },
  "fresh_reference": {
    "every_n_tasks": 100
  },
  "summary": {
    "window": 0.1
  },
  "stream": {
    "name": "cifar100_binary",
    "n_tasks": 1000,
    "train_per_class": 500,
    "test_per_class": 100,
    "normalize": "standard"
  }
}